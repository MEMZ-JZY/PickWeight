<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PickWeight_App.Pages.Settings.SystemSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PickWeight_App.Controls">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" Spacing="12">
            <Button
                AutomationProperties.Name="返回设置"
                Background="Transparent"
                Click="BackButton_Click"
                Padding="10"
                ToolTipService.ToolTip="返回">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="系统设置" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="开机自启动、快捷启动功能" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <StackPanel x:Name="ContentPanel" MaxWidth="860" Spacing="16">
                <ToggleSwitch Header="开机自启" IsOn="{Binding StartWithWindows, Mode=TwoWay}" OffContent="关闭" OnContent="开启" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="程序将在登录 Windows 后自动运行。" TextWrapping="Wrap" />
                <ToggleSwitch Header="快捷启动功能" IsOn="{Binding ShowQuickDrawButton, Mode=TwoWay}" OffContent="关闭" OnContent="开启" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="启用后显示可拖动的快捷启动小窗。" TextWrapping="Wrap" />
                <controls:HotkeyRecorderControl x:Name="GlobalHotkeyRecorder" Header="全局快捷键" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="点击后按下组合键（Ctrl/Alt/Shift/Win 加字母、数字或 F1-F12）；Esc 取消。需包含 Ctrl+Alt 组合，主窗口隐藏时也可触发快速抽取。" TextWrapping="Wrap" />
                <Button Click="FirstRunWizard_Click" Content="重新运行首次运行引导" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="重新配置成员和点名规则，不会删除现有数据。" TextWrapping="Wrap" />
                <Button Click="ShowLocalApiToken_Click" Content="查看本地 API 令牌" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="本地 API 仅监听 127.0.0.1:17861，外部脚本需在 X-PickWeight-Token 请求头中携带令牌。" TextWrapping="Wrap" />
                <Button Click="OpenDataFolder_Click" Content="打开数据文件夹" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="成员、历史与配置保存在 %LOCALAPPDATA%\PickWeight，班级配置位于 classes\班级名\implicit_config.json。" TextWrapping="Wrap" />
                <Button Click="ExportDiagnostics_Click" Content="导出诊断包" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="打包最近 30 天日志与脱敏设置（不含成员数据、不含 API 令牌）为一个 zip，便于反馈问题。" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
